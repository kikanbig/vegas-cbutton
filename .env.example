# Скопировать в .env рядом с docker-compose.yml. Не коммитить.

# Пароль Postgres (придумайте свой, тот же в DATABASE_URL через compose)
POSTGRES_PASSWORD=change-this-db-password

# JWT: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret

# Пустая строка = любой email. Для прод: только корпоративная почта
ALLOWED_EMAIL_DOMAIN=vegas.by

PORT=3001

SMTP_HOST=smtp.hoster.by
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cbutton@vegas.by
SMTP_PASS=
MAIL_FROM=Vegas · Кнопка контакта <cbutton@vegas.by>
